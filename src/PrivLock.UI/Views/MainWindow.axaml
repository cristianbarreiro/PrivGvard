<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PrivLock.UI.ViewModels"
        x:Class="PrivLock.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PrivLock"
        Width="460" Height="550"
        MinWidth="460" MinHeight="550"
        MaxWidth="460" MaxHeight="550"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Foreground="#EDEDED"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="38">

    <Grid RowDefinitions="38,Auto,Auto,Auto,Auto,Auto">
        <!-- 1. Custom Integrated TitleBar -->
        <Border Grid.Row="0" Background="#1A1A1D" IsHitTestVisible="True" PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Settings Dropdown, Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="6">
                    <!-- Settings Dropdown Button -->
                    <Button Background="Transparent" BorderThickness="0" Padding="6,4"
                            VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="Menú y Ajustes">
                        <TextBlock Text="⚙️" FontSize="13" Foreground="#AAAAAA" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="⚙️  Ajustes" />
                                <MenuItem Header="📖  Ayuda y Documentación" />
                                <MenuItem Header="🛡️  Diagnóstico del Sistema" />
                                <Separator />
                                <MenuItem Header="ℹ️  Acerca de PrivLock" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <TextBlock Text="🛡️" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppTitle}" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window Controls -->
                <Button Grid.Column="2" Width="44" Height="38" Background="Transparent" BorderThickness="0"
                        Click="OnMinimizeClick" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <TextBlock Text="—" FontSize="11" Foreground="#AAAAAA" />
                </Button>
                <Button Grid.Column="3" Width="44" Height="38" Background="Transparent" BorderThickness="0"
                        Click="OnCloseClick" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <TextBlock Text="✕" FontSize="12" Foreground="#AAAAAA" />
                </Button>
            </Grid>
        </Border>

        <!-- 2. System Status (Error Toast & Diagnostics Banner) -->
        <StackPanel Grid.Row="1" Margin="16,8,16,0" Spacing="6">
            <!-- Error Toast Banner -->
            <Border Background="#C62828" CornerRadius="8" Padding="12,8"
                    IsVisible="{Binding HasError}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="White" FontSize="12" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Command="{Binding ClearErrorCommand}" Background="Transparent" BorderThickness="0" Padding="4">
                        <TextBlock Text="✕" Foreground="White" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- Platform Diagnostics & Badge Banner -->
            <Border Background="#1F1F22" CornerRadius="8" Padding="12,8" BorderThickness="1" BorderBrush="#2C2C30">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding PlatformName}" FontSize="11" Foreground="#888888" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CapabilitiesSummary}" FontSize="11" Foreground="#007ACC" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#007ACC" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SecurityBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 3. Advanced Protection Card -->
        <Border Grid.Row="2" Margin="16,8,16,0" Classes="card" BorderThickness="1" BorderBrush="#35353A">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="🛡️" FontSize="18" Width="26" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding AdvancedProtectionTitle}" FontSize="13" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding AdvancedProtectionSubtitle}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AdvancedProtectionStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AdvancedProtectionStatusColor}" Margin="0,1,0,0" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsAdvancedProtectionEnabled}"
                              VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- 4. Privacy Controls Group Card -->
        <Border Grid.Row="3" Margin="16,8,16,0" Classes="card" BorderThickness="1" BorderBrush="#35353A">
            <StackPanel>
                <!-- Row 1: Unified Control -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="🔗" FontSize="18" Width="26" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding UnifiedTitle}" FontSize="13" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding UnifiedSubtitle}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding BothStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BothStatusColor}" Margin="0,1,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsBothBlocked}"
                                  VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <Border Height="1" Background="#333338" Margin="0,6" />

                <!-- Row 2: Camera -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="📷" FontSize="18" Width="26" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding CameraTitle}" FontSize="13" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding CameraSubtitle}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CameraStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CameraStatusColor}" Margin="0,1,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsCameraBlocked}"
                                  VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <Border Height="1" Background="#333338" Margin="0,6" />

                <!-- Row 3: Microphone -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="🎙️" FontSize="18" Width="26" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding MicrophoneTitle}" FontSize="13" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding MicrophoneSubtitle}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MicStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding MicStatusColor}" Margin="0,1,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsMicBlocked}"
                                  VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 5. Detected Hardware Devices Section -->
        <StackPanel Grid.Row="4" Margin="16,8,16,8" Spacing="4">
            <TextBlock Text="{Binding DetectedDevicesLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#888888" Margin="4,0,0,0" />
            <Border Background="#1C1C1E" CornerRadius="8" Padding="6" BorderThickness="1" BorderBrush="#2A2A2E">
                <ScrollViewer MaxHeight="86" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DeviceItemViewModel">
                                <Border Padding="8,4" Margin="0,1" Background="#242427" CornerRadius="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#777777" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- 6. Footer: Settings & Language Selector -->
        <Border Grid.Row="5" Background="#141416" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="#252528">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Autostart Checkbox -->
                <CheckBox Grid.Column="0" IsChecked="{Binding IsAutostartEnabled}"
                          Content="{Binding StartWithSystemLabel}" FontSize="12" Foreground="#CCCCCC"
                          Command="{Binding ToggleAutostartCommand}" CommandParameter="{Binding $self.IsChecked}" />

                <!-- Language Selector (ES / EN) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Classes="pill" Classes.active="{Binding IsSpanishSelected}"
                            Command="{Binding SelectLanguageCommand}" CommandParameter="es" Content="ES" />
                    <Button Classes="pill" Classes.active="{Binding IsEnglishSelected}"
                            Command="{Binding SelectLanguageCommand}" CommandParameter="en" Content="EN" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
