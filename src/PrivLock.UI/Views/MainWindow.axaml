<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PrivLock.UI.ViewModels"
        x:Class="PrivLock.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PrivLock"
        Width="460" Height="740"
        MinWidth="420" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Foreground="#EDEDED"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="38">

    <Grid RowDefinitions="38,*,Auto">
        <!-- 1. Custom Integrated TitleBar -->
        <Border Grid.Row="0" Background="#1A1A1D" IsHitTestVisible="True" PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Settings Dropdown, Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="6">
                    <!-- Settings Dropdown Button -->
                    <Button Background="Transparent" BorderThickness="0" Padding="6,4"
                            VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="Menú y Ajustes">
                        <TextBlock Text="⚙️" FontSize="13" Foreground="#AAAAAA" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="⚙️  Ajustes" />
                                <MenuItem Header="📖  Ayuda y Documentación" />
                                <MenuItem Header="🛡️  Diagnóstico del Sistema" />
                                <Separator />
                                <MenuItem Header="ℹ️  Acerca de PrivLock" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <TextBlock Text="🛡️" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppTitle}" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window Controls -->
                <Button Grid.Column="2" Width="44" Height="38" Background="Transparent" BorderThickness="0"
                        Click="OnMinimizeClick" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <TextBlock Text="—" FontSize="11" Foreground="#AAAAAA" />
                </Button>
                <Button Grid.Column="3" Width="44" Height="38" Background="Transparent" BorderThickness="0"
                        Click="OnCloseClick" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <TextBlock Text="✕" FontSize="12" Foreground="#AAAAAA" />
                </Button>
            </Grid>
        </Border>

        <!-- 2. Main Scrollable Content (Hidden Scrollbars) -->
        <ScrollViewer Grid.Row="1" Margin="16,12,16,12"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">

                <!-- Error Toast Banner -->
                <Border Background="#C62828" CornerRadius="8" Padding="12,8"
                        IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="White" FontSize="12" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Command="{Binding ClearErrorCommand}" Background="Transparent" BorderThickness="0" Padding="4">
                            <TextBlock Text="✕" Foreground="White" FontSize="11" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Platform Diagnostics & Badge Banner -->
                <Border Background="#1F1F22" CornerRadius="8" Padding="12,8" BorderThickness="1" BorderBrush="#2C2C30">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding PlatformName}" FontSize="11" Foreground="#888888" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CapabilitiesSummary}" FontSize="11" Foreground="#007ACC" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#007ACC" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SecurityBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= ADVANCED PROTECTION (GLOBAL EXTENSION) CARD ================= -->
                <Border Classes="card" BorderThickness="1" BorderBrush="#35353A">
                    <StackPanel Spacing="10">
                        <!-- Advanced Protection Header -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="🛡️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AdvancedProtectionTitle}" FontSize="15" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="{Binding AdvancedProtectionSubtitle}" FontSize="11" Foreground="#888888" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#333338" Margin="0,2" />

                        <!-- Advanced Protection Toggle -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding AdvancedProtectionDesc}" FontSize="11" Foreground="#777777" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AdvancedProtectionStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AdvancedProtectionStatusColor}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAdvancedProtectionEnabled}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= UNIFIED CONTROL CARD ================= -->
                <Border Classes="card" BorderThickness="1" BorderBrush="#35353A">
                    <StackPanel Spacing="10">
                        <!-- Unified Header -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="🔗" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UnifiedTitle}" FontSize="15" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="{Binding UnifiedSubtitle}" FontSize="11" Foreground="#888888" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#333338" Margin="0,2" />

                        <!-- Unified Block Control -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding UnifiedStandardDesc}" FontSize="11" Foreground="#777777" />
                                <TextBlock Text="{Binding BothStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BothStatusColor}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsBothBlocked}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= CAMERA CARD ================= -->
                <Border Classes="card" BorderThickness="1" BorderBrush="#35353A">
                    <StackPanel Spacing="10">
                        <!-- Camera Header -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="📷" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CameraTitle}" FontSize="15" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="{Binding CameraSubtitle}" FontSize="11" Foreground="#888888" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#333338" Margin="0,2" />

                        <!-- Camera Block Control -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding CameraStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding CameraStatusColor}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsCameraBlocked}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= MICROPHONE CARD ================= -->
                <Border Classes="card" BorderThickness="1" BorderBrush="#35353A">
                    <StackPanel Spacing="10">
                        <!-- Microphone Header -->
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="🎙️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MicrophoneTitle}" FontSize="15" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="{Binding MicrophoneSubtitle}" FontSize="11" Foreground="#888888" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#333338" Margin="0,2" />

                        <!-- Microphone Block Control -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding MicStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding MicStatusColor}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsMicBlocked}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= DETECTED DEVICES LIST ================= -->
                <TextBlock Text="{Binding DetectedDevicesLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#888888" Margin="4,4,0,2" />
                <Border Background="#1C1C1E" CornerRadius="8" Padding="8" BorderThickness="1" BorderBrush="#2A2A2E">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DeviceItemViewModel">
                                <Border Padding="8,6" Margin="0,2" Background="#242427" CornerRadius="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#777777" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 3. Footer: Settings & Language Selector -->
        <Border Grid.Row="2" Background="#141416" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="#252528">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Autostart Checkbox -->
                <CheckBox Grid.Column="0" IsChecked="{Binding IsAutostartEnabled}"
                          Content="{Binding StartWithSystemLabel}" FontSize="12" Foreground="#CCCCCC"
                          Command="{Binding ToggleAutostartCommand}" CommandParameter="{Binding $self.IsChecked}" />

                <!-- Language Selector (ES / EN) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Classes="pill" Classes.active="{Binding IsSpanishSelected}"
                            Command="{Binding SelectLanguageCommand}" CommandParameter="es" Content="ES" />
                    <Button Classes="pill" Classes.active="{Binding IsEnglishSelected}"
                            Command="{Binding SelectLanguageCommand}" CommandParameter="en" Content="EN" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
