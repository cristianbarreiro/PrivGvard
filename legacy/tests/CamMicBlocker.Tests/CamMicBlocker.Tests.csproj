<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CamMicBlocker\CamMicBlocker.csproj" />
  </ItemGroup>

  <Target Name="PreventAccidentalLegacyBuild" BeforeTargets="BeforeBuild;BeforeRebuild">
    <Error Condition="'$(AllowLegacyBuild)' != 'true'" Text="This is the archived PrivLock 1.x test project. Run tests for PrivGvard via CamMicBlocker.sln instead." />
  </Target>

</Project>
