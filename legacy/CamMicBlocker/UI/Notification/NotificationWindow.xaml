<Window x:Class="CamMicBlocker.UI.Notification.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="300" Height="80"
        Loaded="OnLoaded">
    <Border CornerRadius="8" Background="#E6202020" Padding="16,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#AAAAAA"
                       Text="CamMicBlocker"/>
            <TextBlock x:Name="MessageText"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,4,0,0"
                       Text="Status changed"/>
        </StackPanel>
    </Border>
</Window>
